# Public browser configuration. VITE_* values are included in the built app.
# Restrict the API key by API and website origin in Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=your-restricted-api-key
VITE_GOOGLE_APP_ID=your-numeric-cloud-project-number
